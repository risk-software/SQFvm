[   ["assertEqual",     ["trim removes whitespace from both ends", { trim "	 hello, how are you?  " } ], "hello, how are you?"],
    ["assertEqual",     ["trim with characters on both ends", { "hewosentence!123" trim ["3e1o2hw", 0] } ], "sentence!"],
    ["assertEqual",     ["trim with characters at the start", { "xxabcxx" trim ["x", 1] } ], "abcxx"],
    ["assertEqual",     ["trim with characters at the end", { "xxabcxx" trim ["x", 2] } ], "xxabc"],
    ["assertEqual",     ["toLowerANSI", { toLowerANSI "MiXeD 123" } ], "mixed 123"],
    ["assertEqual",     ["toUpperANSI", { toUpperANSI "MiXeD 123" } ], "MIXED 123"],
    ["assertEqual",     ["toString of code drops the braces", { toString { 1 + 2 } } ], "1 + 2"],
    ["assertEqual",     ["toJSON of an array", { toJSON ["this", "is", 1, true] } ], "[""this"",""is"",1,true]"],
    ["assertEqual",     ["toJSON escapes strings", { toJSON "a""b" } ], """a\""b"""],
    ["assertEqual",     ["toJSON of nil inside an array is null", { toJSON [nil] } ], "[null]"],
    ["assertEqual",     ["toJSON of a HashMap is an object", { toJSON createHashMapFromArray [["k", 1]] } ], "{""k"":1}"],
    ["assertEqual",     ["fromJSON of a number", { fromJSON "42" } ], 42],
    ["assertEqual",     ["fromJSON of an array", { fromJSON "[42, ""Hello there"", true]" } ], [42, "Hello there", true]],
    ["assertEqual",     ["fromJSON of an object is a HashMap", { private _map = fromJSON "{""key1"": ""value1""}"; _map get "key1" } ], "value1"],
    ["assertEqual",     ["fromJSON decodes escapes", { fromJSON """a\nb""" } ], "a" + toString [10] + "b"],
    ["assertIsNil",     ["fromJSON of null is nil", { fromJSON "null" } ] ],
    ["assertException", ["fromJSON of invalid JSON is an error", { fromJSON "[1," } ] ],
    ["assertEqual",     ["JSON round trip", { fromJSON toJSON [1, "two", [false]] } ], [1, "two", [false]]],
    ["assertEqual",     ["parseSimpleArray", { parseSimpleArray "[1, ""two"", true, [3]]" } ], [1, "two", true, [3]]],
    ["assertEqual",     ["parseSimpleArray with single quotes", { parseSimpleArray "['a''b']" } ], ["a'b"]],
    ["assertEqual",     ["parseSimpleArray keywords are case-insensitive", { parseSimpleArray "[TRUE, False]" } ], [true, false]],
    ["assertException", ["parseSimpleArray does not compile code", { parseSimpleArray "[hint ""x""]" } ] ]
]
